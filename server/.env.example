# Server configuration. Copy to server/.env and fill in. Never commit server/.env.
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# Firebase project (same project as the web app).
FIREBASE_PROJECT_ID=

# Option A: service-account values (Project settings > Service accounts > Generate new private key).
# Copy client_email and private_key from the downloaded JSON. Keep the \n escapes in the key.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option B: path to the downloaded service-account JSON (leave A empty if you use this).
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
